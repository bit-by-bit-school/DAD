def factorial(n):
    fact=set()
    for number in  range(1,n//2+2,1):
        if n%number==0:
            fact.add(number)
    fact.add(n)        
    return fact


def HCF(arr):
    fact=factorial(arr[0])
    for value in arr[1:]:
        fact=fact.intersection(factorial(value))
    return max(fact)

