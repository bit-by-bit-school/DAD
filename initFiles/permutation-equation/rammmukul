function permutationEquation(p) {
    // Complete this function
    ans=[]
    for(i=0;i<p.length;i++){
        Iloc=0
        for(j=0;j<p.length;j++){
            if(p[j]==i+1){
                Iloc=j+1
                break
            }
        }
        
        for(j=0;j<p.length;j++){
            if(p[j]==Iloc){
                ans.push(j+1)
                break
            }
        }
        
    }
    
    return ans
}

function main() {
    var n = parseInt(readLine());
    p = readLine().split(' ');
    p = p.map(Number);
    var result = permutationEquation(p);
    console.log(result.join("\n"));



}
