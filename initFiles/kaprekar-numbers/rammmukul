function kaprekarNumbers(p, q) {
    // Complete this function
    knum=[]
    
    for(i=p;i<=q;i++){
        num=i
        sq=i*i
        dig=sq.toString().length
        left=parseInt(sq.toString().substr(0,dig/2)) || 0
        right=parseInt(sq.toString().substr(dig/2)) || 0
                
        if(left+right == num){
            knum.push(num)
        }
    }
    
    return knum.length==0? ['INVALID RANGE'] : knum
    
}

function main() {
    var p = parseInt(readLine());
    var q = parseInt(readLine());
    var result = kaprekarNumbers(p, q);
    console.log(result.join(" "));



}
