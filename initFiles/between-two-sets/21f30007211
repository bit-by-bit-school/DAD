def LCM(a, b):
    return a * b // math.gcd(a, b)

    
def LCMArr(arr):
    lcm=arr[0]
    for value in arr[1:]:
        lcm=LCM(lcm,value)
    return lcm
def getTotalX(a, b):
    a1=LCMArr(a)
    b1=HCF(b)
    #print(a1,b1)
    count=0
    
    for value in range(a1,b1+1,1):
        #print(value)
        if value%a1==0 and b1%value==0:
            #print(value)
            count=count+1
    
    return count    
           

