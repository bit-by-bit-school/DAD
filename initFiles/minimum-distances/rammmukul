import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int n = in.nextInt();
        int a[] = new int[n],d=1001;
        for(int A_i=0; A_i < n; A_i++){
            a[A_i] = in.nextInt();
        }
        
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if((a[i]==a[j]))
                    if(j-i<d)
                    d=j-i;
            }
        }
        if(d!=1001)
        System.out.print(d);
        else
            System.out.print(-1);
    }
}
