function equalizeArray(arr) {
    // Complete this function
    max=0
    arrLen = arr.length
    while(arr.length){
        max = Math.max(arr.filter(x=> x==arr[0]).length, max)
        arr=arr.filter(x=> x!=arr[0])
    }
    
    return arrLen-max
}

function main() {
    var n = parseInt(readLine());
    arr = readLine().split(' ');
    arr = arr.map(Number);
    var result = equalizeArray(arr);
    process.stdout.write("" + result + "\n");

}
