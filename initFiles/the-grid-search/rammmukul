function gridSearch(G, P) {
    // Complete this function
    G=G.map(x=>x.split(''))
    P=P.map(x=>x.split(''))
    gX= G[0].length
    gY= G.length
    
    pX= P[0].length
    pY= P.length
    
    
    found=true
    for(x=0;x<=gX-pX;x++){
        for(y=0;y<=gY-pY;y++){
            
            found=true
            for(i=0;i<pX;i++){
                for(j=0;j<pY;j++){
                    if(P[j][i] != G[j+y][i+x]){
                        found=false
                    }
                    if(!found){ break }
                }
                if(!found){ break }
            }
            if(found){ return 'YES'}
            
        }
    }
    
    return 'NO'
}

