{
  "manifest_version": 3,
  "name": "Solutions Hub (HackerRank & LeetCode)",
  "version": "1.1.0",
  "description": "Download, store, browse, search, and compare HackerRank and LeetCode solutions categorized by problems and users.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Solutions Hub (HackerRank & LeetCode)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*.hackerrank.com/*",
    "https://*.leetcode.com/*"
  ]
}
