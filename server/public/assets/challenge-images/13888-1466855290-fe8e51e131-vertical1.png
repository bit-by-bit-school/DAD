<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 220" width="540" height="220">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#080a0f"/>
      <stop offset="100%" stop-color="#121824"/>
    </linearGradient>
    <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0, 229, 255, 0.05)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="540" height="220" fill="url(#bg)"/>
  <rect width="540" height="220" fill="url(#grid)"/>
  <rect x="2" y="2" width="536" height="216" fill="none" stroke="rgba(0, 229, 255, 0.3)" stroke-width="1" stroke-dasharray="4 2"/>
  
  <!-- Outer Corner Accents -->
  <path d="M 10 20 L 10 10 L 20 10" fill="none" stroke="#00e5ff" stroke-width="2"/>
  <path d="M 530 20 L 530 10 L 520 10" fill="none" stroke="#00e5ff" stroke-width="2"/>
  <path d="M 10 200 L 10 210 L 20 210" fill="none" stroke="#00e5ff" stroke-width="2"/>
  <path d="M 530 200 L 530 210 L 520 210" fill="none" stroke="#00e5ff" stroke-width="2"/>

  <!-- Center Graphic & Terminal Icon -->
  <g transform="translate(270, 75)" text-anchor="middle">
    <circle cx="0" cy="0" r="32" fill="rgba(0, 229, 255, 0.08)" stroke="#00e5ff" stroke-width="1.5"/>
    <path d="M -12 -8 L -4 0 L -12 8 M 0 8 L 12 8" fill="none" stroke="#00e5ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Title & Metadata -->
  <text x="270" y="140" fill="#00e5ff" font-family="'Share Tech Mono', Consolas, monospace" font-size="14" font-weight="bold" letter-spacing="1.5" text-anchor="middle">VERTICAL1</text>
  <text x="270" y="165" fill="#64748b" font-family="'Share Tech Mono', Consolas, monospace" font-size="11" letter-spacing="0.5" text-anchor="middle">HACKERRANK DIAGRAM // ARCHIVED ASSET</text>
  <text x="270" y="185" fill="#94a3b8" font-family="'Share Tech Mono', Consolas, monospace" font-size="9" letter-spacing="0.5" text-anchor="middle">[ REFER TO PROBLEM DESCRIPTION TEXT FOR SPECIFICATIONS ]</text>
</svg>