import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int n = in.nextInt(),i=0,j=0;
        int k = in.nextInt();
        int a[] = new int[n];
        int c=0;
        for(int a_i=0; a_i < n; a_i++){
            a[a_i] = in.nextInt();
        }
        for(i=0;i<n;i++){
            for(j=i+1;j<n;j++){
                if((a[i]+a[j])%k==0)
                    c++;
            }
        }
            System.out.print(c);
    }
}
