#include <math.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <assert.h>
#include <limits.h>
#include <stdbool.h>

long int andProduct(long int a, long int b) {
    // Complete this function
    long result=a;
    for(long i=a+1;i<=b;i++){
        result &= i;
    }
    return result;
}

int main() {
    int n; 
    scanf("%i", &n);
    for(int a0 = 0; a0 < n; a0++){
        long int a; 
        long int b; 
        scanf("%li %li", &a, &b);
        long int result = andProduct(a, b);
        printf("%ld\n", result);
    }
    return 0;
}
